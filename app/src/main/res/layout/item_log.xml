<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvLogStatusIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢"
            android:textSize="20sp"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/tvLogTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:40:00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:paddingEnd="12dp" />

        <TextView
            android:id="@+id/tvLogMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Connexion réussie"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1B5E20" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLogSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prelogin: OK | Form: OK | POST: OK | Logon: OK | HTTP204: OK"
        android:textSize="14sp"
        android:textColor="#555555"
        android:paddingTop="6dp" />

    <TextView
        android:id="@+id/tvLogDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Détails de l'erreur..."
        android:textSize="13sp"
        android:textColor="#888888"
        android:paddingTop="4dp"
        android:visibility="gone" />

</LinearLayout>
